# Copy this file to .env before starting the stack. Never commit .env.
# Full setup: docs/SETUP_RU.md. Agent handoff: docs/AGENT_PROMPT_RU.md.
COMPOSE_PROJECT_NAME=threads-recruitment-manager
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_TIMEZONE=Europe/Warsaw
DEFAULT_LANGUAGE=uk
LOG_LEVEL=INFO

# Browser-visible ports. MySQL, Adminer, and Hermes bind to loopback only.
FRONTEND_PORT=3000
BACKEND_PORT=8000
LITELLM_PORT=4000
ADMINER_PORT=8081
MYSQL_HOST_PORT=3307
HERMES_HOST_PORT=8642

# Database. Generate long, unique values for non-demo deployments.
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=threads_recruitment
MYSQL_USER=threads_app
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password
# URL-encode reserved characters in the password used in DATABASE_URL.
DATABASE_URL=mysql+aiomysql://threads_app:replace-with-a-long-random-password@mysql:3306/threads_recruitment

# Runtime queue, scheduler state, and distributed locks.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Safe defaults: external publishing and autonomous replies are disabled.
THREADS_MOCK_MODE=true
AI_MOCK_MODE=true
AUTO_POST=false
AUTO_REPLY=false
AUTO_EXTERNAL_COMMENT=false
# Publication limits. Defaults match app/config.py (single source of truth).
# Values here override config.py; the worker applies min(settings, DB setting).
MAX_POSTS_PER_HOUR=4
MAX_REPLIES_PER_HOUR=12

# LiteLLM is the only model gateway used by application business logic.
# Cloud / Ollama / compatible gateway recipes: docs/AI_RU.md.
LITELLM_BASE_URL=http://litellm:4000
LITELLM_MASTER_KEY=replace-with-a-long-random-litellm-key
# Default config is deterministic and makes no provider network calls.
# Change to /app/config.yaml after setting at least one provider key/model.
LITELLM_CONFIG_FILE=/app/config.mock.yaml
# Local Ollama defaults (verified: non-thinking, answers uk/pl/ru/en, always
# returns non-empty content). Requires Ollama on the host at port 11434.
# This is the RESERVE: it is the last link of every model fallback chain.
LITELLM_LOCAL_MODEL=ollama_chat/qwen3:4b-instruct
LITELLM_LOCAL_API_BASE=http://host.docker.internal:11434
# OmniRoute gateway (local, OpenAI-compatible /v1). It is the primary model
# route: the alias models are chosen explicitly, because the "auto/*" routes
# of OmniRoute answer in the language of whatever model they pick, and this
# account publishes in Ukrainian only.
OMNIROUTE_BASE_URL=http://host.docker.internal:20128/v1
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL_FAST=openai/antigravity/gemini-3.1-flash-lite
OMNIROUTE_MODEL_DEFAULT=openai/antigravity/gemini-3-flash
OMNIROUTE_MODEL_REASONING=openai/antigravity/gemini-3.8-flash-high
# Only needed when a route points at a cloud provider instead of the local
# gateway. The local gateway ignores the key.
LITELLM_PROVIDER_API_KEY=ollama
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
# Official Nous Research Hermes Agent API server. Keep this key private.
HERMES_BASE_URL=http://hermes:8642
HERMES_API_KEY=replace-with-a-long-random-hermes-key
HERMES_IMAGE=nousresearch/hermes-agent:v2026.9.24

# Official Meta Threads API credentials. Leave blank in mock mode.
# Full step-by-step setup: docs/THREADS_RU.md
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=http://localhost:8000/api/threads/oauth/callback
THREADS_ACCESS_TOKEN=
THREADS_API_BASE_URL=https://graph.threads.net
# Meta App Dashboard > Threads Webhooks > callback verification token.
# Leave empty to disable the webhook endpoint (polling keeps working).
THREADS_WEBHOOK_VERIFY_TOKEN=
# Optional: explicit key for encrypting stored Threads tokens in MySQL.
# When empty, a key is derived from LITELLM_MASTER_KEY (see docs).
THREADS_TOKEN_KEY=
# Single operator token protecting the whole API (sent by the UI as the
# X-Operator-Token header). Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty only for local development; in other environments the API
# answers 503 until this value is set.
OPERATOR_TOKEN=

# Optional official Instagram Business Login and TikTok Login Kit credentials.
# Keep empty for local mock mode; provider APIs are never called without them.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/social/oauth/instagram/callback
INSTAGRAM_API_BASE_URL=https://graph.instagram.com
INSTAGRAM_API_VERSION=v25.0
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8000/api/social/oauth/tiktok/callback
TIKTOK_API_BASE_URL=https://open.tiktokapis.com
SOCIAL_TOKEN_KEY=
# Privileged provider routes remain loopback-only until application auth exists.
SOCIAL_LOCAL_ONLY=true
ALLOW_MANUAL_TOKEN_IMPORT=false

# Optional local ComfyUI media generation. Workflows are API-format JSON files;
# this project does not download model weights automatically.
COMFYUI_BASE_URL=http://host.docker.internal:8188
COMFYUI_MOCK_MODE=true
LOCAL_VIDEO_FALLBACK=true
LOCAL_VIDEO_DURATION_SECONDS=5
COMFYUI_WORKFLOW_DIR=/app/workflows
COMFYUI_IMAGE_WORKFLOW=
COMFYUI_VIDEO_WORKFLOW=
COMFYUI_TIMEOUT_SECONDS=1800
MEDIA_OUTPUT_DIR=/app/data/media
MEDIA_PUBLIC_BASE_URL=
MEDIA_MAX_BYTES=100000000
MEDIA_DISK_QUOTA_BYTES=2000000000
IMAGE_CHECKPOINT=
WAN_TEXT_ENCODER=

# Telegram vacancy source. The bot must be an administrator of the channel.
# Setup: docs/TELEGRAM_RU.md. Use your public channel username, not a private ID.
# These credentials enable real Telegram polling independently of AI/Threads mock mode.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=
TELEGRAM_POLL_INTERVAL_SECONDS=60

# Frontend build configuration contains no secrets.
VITE_API_URL=/api
VITE_MOCK_MODE=false

# Data retention (audit I-7/D13). The weekly worker task only REPORTS the
# amount it would prune until this is explicitly enabled; enabling mass
# deletion is an owner decision and must follow scripts/backup-db.ps1.
RETENTION_ENABLED=false
RETENTION_ACTIVITY_DAYS=90
RETENTION_POLICY_DAYS=180
RETENTION_JOBS_DAYS=30
RETENTION_AGENT_RUNS_DAYS=90
